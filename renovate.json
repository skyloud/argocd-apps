{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMajorReleases",
    ":ignoreUnstable"
  ],
  "semanticCommits": "enabled",
  "ignorePaths": [
    ".claude/**"
  ],
  "helmv3": {
    "rangeStrategy": "bump"
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^sky/kubernetes-event-exporter(-helm)?/.+\\.yaml$/",
      "/^sky/scaleway-ccm/templates/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions downloaded by the argocd skyloud plugin",
      "managerFilePatterns": [
        "/^argoproj/argo-cd/plugins/skyloud\\.yaml$/"
      ],
      "matchStrings": [
        "name: (?<depName>SOPS|YQ|HELM)_VERSION\\s+value: \"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "{{#if (equals depName 'SOPS')}}getsops/sops{{else if (equals depName 'YQ')}}mikefarah/yq{{else}}helm/helm{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "OCI charts are looked up as docker tags, keep helm ranges valid",
      "matchManagers": [
        "helmv3"
      ],
      "matchDatasources": [
        "docker"
      ],
      "versioning": "helm"
    },
    {
      "description": "A dependency major releases a wrapper major (git-cliff in release-charts)",
      "matchUpdateTypes": [
        "major"
      ],
      "commitMessagePrefix": "chore(deps)!:"
    },
    {
      "description": "Minor/patch land on main as commits once lint-charts is green; majors stay PRs merged by hand",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "automerge": true,
      "automergeType": "branch"
    }
  ]
}
