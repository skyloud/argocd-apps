{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMajorReleases",
    ":ignoreUnstable"
  ],
  "semanticCommits": "enabled",
  "ignorePaths": [
    ".claude/**"
  ],
  "helmv3": {
    "rangeStrategy": "bump"
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^sky/kubernetes-event-exporter(-helm)?/.+\\.yaml$/",
      "/^sky/scaleway-ccm/templates/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions downloaded by the argocd skyloud plugin",
      "managerFilePatterns": [
        "/^argoproj/argo-cd/plugins/skyloud\\.yaml$/"
      ],
      "matchStrings": [
        "name: (?<depName>SOPS|YQ|HELM)_VERSION\\s+value: \"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "{{#if (equals depName 'SOPS')}}getsops/sops{{else if (equals depName 'YQ')}}mikefarah/yq{{else}}helm/helm{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Gateway API CRDs vendored from the release asset",
      "managerFilePatterns": [
        "/^kubernetes-sigs/gateway-api/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+appVersion: \"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Re-download the vendored Gateway API CRDs of the new release (allowed in the bot's config.js)",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "kubernetes-sigs/gateway-api"
      ],
      "postUpgradeTasks": {
        "commands": [
          "curl -fsSL -o kubernetes-sigs/gateway-api/files/experimental-install.yaml https://github.com/kubernetes-sigs/gateway-api/releases/download/{{{newVersion}}}/experimental-install.yaml"
        ],
        "fileFilters": [
          "kubernetes-sigs/gateway-api/files/**"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "OCI charts are looked up as docker tags, keep helm ranges valid",
      "matchManagers": [
        "helmv3"
      ],
      "matchDatasources": [
        "docker"
      ],
      "versioning": "helm"
    },
    {
      "description": "A dependency major releases a wrapper major (git-cliff in release-charts)",
      "matchUpdateTypes": [
        "major"
      ],
      "commitMessagePrefix": "chore(deps)!:"
    },
    {
      "description": "Minor/patch/digest/pin grouped on one branch, pushed to main by Renovate once lint-charts is green (no PR, no approval); majors stay PRs merged by hand",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true,
      "automergeType": "branch"
    }
  ]
}
